# ==========================================
# CONFIGURACIÓN DEL FRONTEND - AI Cobranza
# ==========================================
# Copia este archivo como .env.local en el directorio frontend/
# NUNCA subas el archivo .env.local a Git.

# URL de tu proyecto Supabase (para autenticación)
VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co

# Clave ANON (pública) de Supabase
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...TU_CLAVE_ANON

# URL del Backend API
# Desarrollo local: http://127.0.0.1:8000/api/v1
# Producción: https://tu-api.com/api/v1
VITE_BACKEND_URL=http://127.0.0.1:8000/api/v1
