# ==========================================
# CONFIGURACIÓN DEL ENTORNO - AI Cobranza Lean SaaS
# ==========================================
# Copia este archivo como .env y reemplaza los valores con tus credenciales reales.
# NUNCA subas el archivo .env a Git.

# ------------------------------------------
# BASE DE DATOS (Supabase PostgreSQL)
# ------------------------------------------
# URL de conexión asíncrona para SQLAlchemy
# Formato: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres.TU_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------
# SUPABASE AUTH (Para autenticación JWT)
# ------------------------------------------
# URL de tu proyecto Supabase
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co

# Clave ANON (pública) para inicializar el cliente de Supabase
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...TU_CLAVE_ANON

# ------------------------------------------
# GROQ API (Para generación de mensajes IA)
# ------------------------------------------
# Clave de API de Groq para el modelo Llama 3
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# ------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# ------------------------------------------
# Entorno: development, production
APP_ENV=development

# Puerto del servidor FastAPI
PORT=8000

# Timeout para llamadas a APIs externas (segundos)
API_TIMEOUT=30

# ------------------------------------------
# LOGGING
# ------------------------------------------
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------
# CORS (Opcional - para producción)
# ------------------------------------------
# Orígenes permitidos separados por coma (sin espacios)
# Ejemplo: https://miapp.com,https://admin.miapp.com
ALLOWED_ORIGINS=https://miapp.com

# ------------------------------------------
# RATE LIMITING (Opcional)
# ------------------------------------------
# Máximo de peticiones por minuto por usuario
RATE_LIMIT_PER_MINUTE=60
